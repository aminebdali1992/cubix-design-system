{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cubix registry item",
  "type": "object",
  "required": ["name", "type", "files"],
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable kebab-case id used by the CLI."
    },
    "type": {
      "type": "string",
      "enum": [
        "registry:ui",
        "registry:component",
        "registry:block",
        "registry:hook",
        "registry:lib",
        "registry:style"
      ]
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "npm packages installed with the item."
    },
    "registryDependencies": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Other registry items installed first."
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "type": { "type": "string" },
          "target": { "type": "string" },
          "content": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  }
}
