{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cubix registry index",
  "type": "object",
  "required": ["name", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string" },
    "homepage": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "type": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "registryDependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path"],
              "properties": {
                "path": { "type": "string" },
                "type": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
