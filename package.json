{
  "name": "cubix-web",
  "version": "0.1.0",
  "private": true,
  "description": "Cubix - beautifully designed components that you can copy and paste into your apps. Accessible. Customizable. Open Source.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cli": "npm run build -w cubix-ui",
    "typecheck": "tsc --noEmit && npm run typecheck -w cubix-ui",
    "cubix": "npm run build -w cubix-ui && node packages/cubix/dist/index.js",
    "readiness:sync": "node scripts/sync-component-readiness.mjs",
    "registry:build": "npm run readiness:sync && npm run build:cli && npm run cubix -- build ./registry.json -o ./public/r -c .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:registry": "node scripts/test-registry-packaging.mjs",
    "test:mcp": "node scripts/test-mcp.mjs",
    "test:mcp-registry": "node scripts/test-mcp-registry.mjs",
    "audit:ready": "node scripts/audit-ready-components.mjs",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "start": "next start",
    "lint": "eslint ."
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-table": "^9.2.4",
    "@types/three": "^0.186.0",
    "chrono-node": "^2.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^0.545.0",
    "next": "^15.5.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-aria-components": "^1.21.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.13.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "sugar-high": "^2.4.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.186.1",
    "use-stick-to-bottom": "^1.1.6",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.1.14",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.4",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
